{
  "name": "model-fit-explorer",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "description": "Local AI Model Fit Explorer: what local models can run on your computer, and how well.",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test --workspace",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "probe": "cd src-tauri && cargo run -q -p hwprobe --bin hwprobe",
    "build:pages": "tsc --noEmit -p tsconfig.json && VITE_STATIC_HOSTING=1 vite build --base=/local-llm-fit/",
    "catalog:refresh": "tsx scripts/refresh-catalog.ts --out-csv catalog/ollama_model_catalog_2026-10_verified.csv",
    "docs:screenshots": "DOCS_SCREENSHOTS=1 playwright test e2e/docs-screenshots.spec.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "author": "Pasindu Ranasinghe",
  "license": "MIT",
  "homepage": "https://maninka123.github.io/local-llm-fit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maninka123/local-llm-fit.git"
  }
}
