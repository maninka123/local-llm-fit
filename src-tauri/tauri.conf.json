{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Fit Explorer",
  "version": "../package.json",
  "identifier": "io.github.maninka123.modelfitexplorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Fit Explorer",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0b1020"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "See which local AI models fit your computer",
    "longDescription": "Detects your hardware and estimates which local AI models (Ollama) fit in GPU memory, RAM or unified memory, with honest confidence and optional local benchmarks.",
    "copyright": "\u00a9 2026 Pasindu Ranasinghe. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1ODhFOEZCRjIxREQzMTAKUldRUTB4M3krK2lJbFZiY2V6SkRXMGVTL1BmeFhJMGJSaXNaNzcxT0lQZ1p3c0NpazIrWjluTnUK",
      "endpoints": [
        "https://github.com/maninka123/local-llm-fit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
